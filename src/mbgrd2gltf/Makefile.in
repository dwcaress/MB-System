	-$(am__rm_f) $(CONFIG_CLEAN_FILES)
	-test . = "$(srcdir)" || $(am__rm_f) $(CONFIG_CLEAN_VPATH_FILES)
	-$(am__rm_f) draco/attributes/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) draco/attributes/$(am__dirstamp)
	-$(am__rm_f) draco/compression/$(DEPDIR)/$(am__dirstamp)

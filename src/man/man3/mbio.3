.br
int \fBmb_input_init\fP(
 		int \fIverbose\fP,
 		char \fI*socket_definition\fP,
 		int \fIformat\fP,
 		int \fIpings\fP,
 		int \fIlonflip\fP,
 		double \fIbounds[4]\fP,
 		int \fIbtime_i[7]\fP,
 		int \fIetime_i[7]\fP,
 		double \fIspeedmin\fP,
 		double \fItimegap\fP,
 		void \fI**mbio_ptr\fP,
 		double \fI*btime_d\fP,
 		double \fI*etime_d\fP,
 		int \fI*beams_bath\fP,
 		int \fI*beams_amp\fP,
 		int \fI*pixels_ss\fP,
 		int \fI(*input_open)(int verbose, void *mbio_ptr, char *definition, int *error)\fP,
 		int \fI(*input_read)(int verbose, void *mbio_ptr, size_t *size, char *buffer, int *error)\fP,
 		int \fI(*input_close)(int verbose, void *mbio_ptr, int *error)\fP,
 		int \fI*error\fP);

The function \fBmb_input_init\fP initializes an \fBMBIO\fP
descriptor for reading in the same manner as \fBmb_read_init\fP,
except that the data source is a socket, pipe, or other streamed
input identified by \fIsocket_definition\fP rather than an
ordinary file, and the calling program supplies its own
\fIinput_open\fP, \fIinput_read\fP, and \fIinput_close\fP
callback functions to open, read raw bytes from, and close that
input source. This allows \fBMBIO\fP to read swath data streamed
in real time (e.g. \fBmbtrnpp\fP) using the same
\fBmb_read\fP/\fBmb_get_all\fP/\fBmb_extract\fP interface used for
ordinary files.


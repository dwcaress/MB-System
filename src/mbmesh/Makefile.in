	-rm -f ./$(DEPDIR)/mbmesh-settings.Po
	-rm -f ./$(DEPDIR)/mbmesh_test_settings-settings.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh-marching_cubes.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh-normal_estimation.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh-point_decimation.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh-screened_poisson.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh-support_trimming.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh_test_marching_cubes-marching_cubes.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh_test_normal_estimation-normal_estimation.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh_test_settings-marching_cubes.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh_test_settings-normal_estimation.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh_test_settings-point_decimation.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh_test_settings-screened_poisson.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh_test_settings-support_trimming.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh_test_support_trimming-marching_cubes.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh_test_support_trimming-screened_poisson.Po
	-rm -f src/algorithms/$(DEPDIR)/mbmesh_test_support_trimming-support_trimming.Po
	-rm -f src/io/$(DEPDIR)/mbmesh-datalist_reader.Po
	-rm -f src/io/$(DEPDIR)/mbmesh-glb_writer.Po
	-rm -f src/io/$(DEPDIR)/mbmesh-x3dom_writer.Po
	-rm -f src/io/$(DEPDIR)/mbmesh-xyz_writer.Po
	-rm -f src/io/$(DEPDIR)/mbmesh_test_marching_cubes-glb_writer.Po
	-rm -f src/io/$(DEPDIR)/mbmesh_test_normal_estimation-glb_writer.Po
	-rm -f src/io/$(DEPDIR)/mbmesh_test_settings-datalist_reader.Po
	-rm -f src/io/$(DEPDIR)/mbmesh_test_support_trimming-glb_writer.Po
	-rm -f tests/$(DEPDIR)/mbmesh_test_marching_cubes-test_marching_cubes.Po
	-rm -f tests/$(DEPDIR)/mbmesh_test_normal_estimation-test_normal_estimation.Po
	-rm -f tests/$(DEPDIR)/mbmesh_test_settings-test_settings.Po
	-rm -f tests/$(DEPDIR)/mbmesh_test_support_trimming-test_support_trimming.Po
	-rm -f Makefile
maintainer-clean-am: distclean-am maintainer-clean-generic

mostlyclean: mostlyclean-am

mostlyclean-am: mostlyclean-compile mostlyclean-generic \
	mostlyclean-libtool

pdf: pdf-am

pdf-am:

ps: ps-am

ps-am:

uninstall-am: uninstall-binPROGRAMS

.MAKE: check-am install-am install-strip

.PHONY: CTAGS GTAGS TAGS all all-am am--depfiles check check-TESTS \
	check-am clean clean-binPROGRAMS clean-checkPROGRAMS \
	clean-generic clean-libtool cscopelist-am ctags ctags-am \
	distclean distclean-compile distclean-generic \
	distclean-libtool distclean-tags dvi dvi-am html html-am info \
	info-am install install-am install-binPROGRAMS install-data \
	install-data-am install-dvi install-dvi-am install-exec \
	install-exec-am install-html install-html-am install-info \
	install-info-am install-man install-pdf install-pdf-am \
	install-ps install-ps-am install-strip installcheck \
	installcheck-am installdirs maintainer-clean \
	maintainer-clean-generic mostlyclean mostlyclean-compile \
	mostlyclean-generic mostlyclean-libtool pdf pdf-am ps ps-am \
	recheck tags tags-am uninstall uninstall-am \
	uninstall-binPROGRAMS

.PRECIOUS: Makefile


# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:

# Tell GNU make to disable its built-in pattern rules.
